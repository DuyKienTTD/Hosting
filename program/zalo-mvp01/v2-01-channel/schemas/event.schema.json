{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Channel event",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "accountId": {
          "type": "string",
          "minLength": 1
        },
        "eventId": {
          "type": "string",
          "minLength": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "type": {
          "const": "messageReceived"
        },
        "payload": {
          "type": "object",
          "properties": {
            "messageId": {
              "type": "string",
              "minLength": 1
            },
            "senderId": {
              "type": "string",
              "minLength": 1
            },
            "thread": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "direct"
                      ]
                    },
                    "conversationId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "conversationId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "group"
                      ]
                    },
                    "groupId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "groupId"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "messageId",
            "senderId",
            "thread",
            "text"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "accountId",
        "eventId",
        "occurredAt",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "accountId": {
          "type": "string",
          "minLength": 1
        },
        "eventId": {
          "type": "string",
          "minLength": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "type": {
          "const": "friendAccepted"
        },
        "payload": {
          "type": "object",
          "properties": {
            "contactId": {
              "type": "string",
              "minLength": 1
            },
            "evidenceId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "contactId",
            "evidenceId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "accountId",
        "eventId",
        "occurredAt",
        "type",
        "payload"
      ],
      "additionalProperties": false
    }
  ]
}
