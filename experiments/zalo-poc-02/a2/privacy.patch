+export type InboundPolicyReader = (scope: {
+  accountId: string; senderId: string; threadId: string;
+  threadType: "dm" | "group";
+}) => (PolicyMutation & { passiveGroup?: boolean }) | null;
+
+export function readInboundConsent(
+  config: AccountConfig, msg: ParsedMessage, readPolicy?: InboundPolicyReader,
+): PrivacyConsent | undefined {
+  if (!readPolicy || !config.id || !msg.senderId || !msg.threadId) return undefined;
+  try {
