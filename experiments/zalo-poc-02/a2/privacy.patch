+describe("explicit synthetic consent scope and independent permissions", () => {
+  function examine(overrides: Partial<PrivacyConsent>) {
+    const account = makeAccount(), msg = makeMessage();
+    return shouldRespond(account, msg, true, syntheticConsent(account, msg, overrides));
+  }
+  it("missing consent denies response and retention", () => {
+    const d = shouldRespond(makeAccount(), makeMessage());
+    assert.deepEqual([d.respond, d.record], [false, false]);
+  });
+  it("authorized response-only never grants retention", () => {
+    const d = examine({ respond: true, retain: false });
+    assert.deepEqual([d.respond, d.record], [true, false]);
+  });
+  it("authorized retain-only never grants response", () => {
+    const d = examine({ respond: false, retain: true });
+    assert.deepEqual([d.respond, d.record], [false, true]);
+  });
+  it("explicit deny of both scopes", () => {
+    const d = examine({ respond: false, retain: false });
+    assert.deepEqual([d.respond, d.record], [false, false]);
+  });
+  it("expired, revoked, human takeover, STOP or invalid revision deny both", () => {
+    for (const o of [{ expiresAt: 1 }, { revoked: true },
+      { humanTakeover: true }, { stopped: true }, { revision: 0 }]) {
+      const d = examine(o);
+      assert.deepEqual([d.respond, d.record], [false, false]);
+    }
+  });
