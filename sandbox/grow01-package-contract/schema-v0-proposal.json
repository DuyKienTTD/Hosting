{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GROW-01/S2 synthetic editorial package v0 proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "source_ref", "source_sha", "revision", "language", "target_channel", "asset_refs", "asset_rights_status", "technical_review_status", "marketing_review_status", "owner_approval_status", "consent_status", "channel_status", "proposed_cost", "state", "decision_log", "idempotency_key", "content_digest", "created_at_utc", "updated_at_utc", "content_note"],
  "properties": {
    "package_id": {"type": "string", "pattern": "^P[1-3]-[a-z0-9-]{3,80}$"},
    "source_ref": {"type": "string", "maxLength": 256},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "revision": {"type": "integer", "minimum": 1},
    "language": {"enum": ["vi", "en", "en-vi"]},
    "target_channel": {"enum": ["youtube_shorts", "youtube_video", "wordpress_page"]},
    "asset_refs": {"type": "array", "maxItems": 8, "items": {"type": "object", "required": ["asset_ref", "kind", "rights"], "additionalProperties": false, "properties": {"asset_ref": {"type": "string", "maxLength": 100}, "kind": {"const": "synthetic_placeholder"}, "rights": {"const": "UNVERIFIED"}}}},
    "asset_rights_status": {"enum": ["UNVERIFIED", "VERIFIED_FIXTURE"]},
    "technical_review_status": {"enum": ["UNVERIFIED", "VERIFIED_FIXTURE"]},
    "marketing_review_status": {"enum": ["UNVERIFIED", "VERIFIED_FIXTURE"]},
    "owner_approval_status": {"enum": ["UNVERIFIED", "FIXTURE_APPROVED_NOT_PUBLISH"]},
    "consent_status": {"enum": ["UNVERIFIED", "VERIFIED_FIXTURE"]},
    "channel_status": {"enum": ["UNVERIFIED", "VERIFIED_FIXTURE"]},
    "proposed_cost": {"type": "null", "description": "No cost proposal or paid media execution authorized"},
    "state": {"enum": ["DRAFT", "IN_REVIEW", "NEEDS_CHANGES", "READY_FOR_OWNER_REVIEW", "APPROVED_FOR_OFFLINE_HANDOFF", "BLOCKED", "REJECTED"]},
    "decision_log": {"type": "array", "maxItems": 64, "items": {"type": "object"}},
    "idempotency_key": {"type": ["null", "string"], "maxLength": 64},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "updated_at_utc": {"type": "string", "format": "date-time"},
    "content_note": {"type": "string", "maxLength": 256}
  },
  "x-contract-boundary": "Proposal only. Python stdlib validates required semantic subset; JSON Schema is documented and not executed by a JSON Schema engine. No real IAM, persistence or publication."
}
